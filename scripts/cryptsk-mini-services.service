[Unit]
Description=Cryptsk ISP Platform - Mini Services (billing, monitoring, radius, whatsapp)
After=network.target

[Service]
Type=forking
User=cryptsk
Group=cryptsk
WorkingDirectory=/opt/cryptsk/app
EnvironmentFile=/opt/cryptsk/app/.env
ExecStart=/opt/cryptsk/app/mini-services/start-all.sh
ExecStop=/opt/cryptsk/app/mini-services/stop-all.sh
PIDFile=/opt/cryptsk/logs/mini-services.pid
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
