// ============================================================
// PARTNER MANAGEMENT — ISP → Distribution Hub → Partner → Subscriber
// Per user spec: Partner is the primary operational and billing
// ownership boundary for subscribers. Every subscriber must belong
// to a Partner. Partner users have scoped access (data isolation).
// ============================================================

model DistributionHub {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  description String   @default("")
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  Partner     Partner[]

  @@index([status])
}

model Partner {
  id                  String   @id @default(uuid())
  distributionHubId   String
  name                String
  code                String   @unique
  description         String   @default("")
  status              String   @default("ACTIVE")
  contactName         String   @default("")
  contactPhone        String   @default("")
  contactEmail        String   @default("")
  address             String   @default("")
  logoUrl             String   @default("")
  primaryColor         String   @default("")
  customDomain        String   @default("")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  DistributionHub     DistributionHub @relation(fields: [distributionHubId], references: [id], onDelete: Cascade)
  PartnerUser         PartnerUser[]
  Subscriber          Subscriber[]
  PartnerIpPool       PartnerIpPool[]
  PartnerPortalMapping PartnerPortalMapping[]

  @@index([distributionHubId])
  @@index([status])
  @@index([code])
}

enum PartnerUserRole {
  PARTNER_ADMIN
  BILLING_USER
  SUPPORT_USER
  READONLY_USER
}

