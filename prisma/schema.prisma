model Complaint {
  id                String             @id @default(uuid())
  ticketNumber      String             @unique
  subscriberId      String?
  areaId            String?
  type              ComplaintType
  priority          ComplaintPriority  @default(P3_MEDIUM)
  description       String
  assignedToId      String?
  status            ComplaintStatus    @default(OPEN)
  slaHours          Int                @default(24)
  slaDeadline       DateTime?
  walkInName        String             @default("")
  resolutionNotes   String             @default("")
  resolvedAt        DateTime?
  resolvedById      String?
  customerRating    Int?
  customerFeedback  String             @default("")
  aiCategory        String             @default("")
  aiSeverity        String             @default("")
  aiProbableCause   String             @default("")
  aiResolutionGuide String             @default("")
  escalationLevel   Int                @default(0)
  isSlaPaused       Boolean            @default(false)
  slaPausedAt       DateTime?
  slaPausedTotalMs  Int                @default(0)
  slaPauseReason    String             @default("")
  createdAt         DateTime           @default(now())
  updatedAt DateTime @updatedAt
  Area              Area?              @relation(fields: [areaId], references: [id])
  Technician        Technician?        @relation(fields: [assignedToId], references: [id])
  Subscriber        Subscriber?        @relation(fields: [subscriberId], references: [id])
  ComplaintComment  ComplaintComment[]

  @@index([areaId])
  @@index([areaId, status])
  @@index([createdAt])
  @@index([priority])
  @@index([status])
  @@index([status, priority])
  @@index([subscriberId])
  @@index([ticketNumber])
}

