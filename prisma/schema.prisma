generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AddOnService {
  id              String            @id @default(uuid())
  name            String            @unique
  description     String            @default("")
  chargeType      AddOnChargeType   @default(FLAT)
  chargeValue     Float             @default(0)
  validityDays    Int               @default(30)
  dataMb          Float?
  isActive        Boolean           @default(true)
  sortOrder       Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt DateTime @updatedAt
  SubscriberAddOn SubscriberAddOn[]

  @@index([isActive])
  @@index([sortOrder])
}

model AgentFollowUp {
  id           String    @id @default(uuid())
  agentId      String
  subscriberId String?
  type         String    @default("GENERAL")
  notes        String    @default("")
  dueDate      DateTime?
  status       String    @default("PENDING")
  createdAt    DateTime  @default(now())

  @@index([agentId])
  @@index([dueDate])
  @@index([status])
}

model AgentReconciliation {
  id              String   @id @default(uuid())
  agentId         String
  date            DateTime
  expectedAmount  Float    @default(0)
  collectedAmount Float    @default(0)
  difference      Float    @default(0)
  status          String   @default("PENDING")
  reconciledBy    String?
  createdAt       DateTime @default(now())

  @@index([agentId])
  @@index([date])
  @@index([status])
}

model AlertComment {
  id           String       @id @default(uuid())
  alertId      String
  userId       String
  message      String
  createdAt    DateTime     @default(now())
  updatedAt DateTime @updatedAt
  NetworkAlert NetworkAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  User         User         @relation(fields: [userId], references: [id])

  @@index([alertId])
  @@index([userId])
}

model AlertRule {
  id                         String             @id @default(uuid())
  name                       String
  condition                  String             @default("")
  threshold                  Float              @default(0)
  severity                   String             @default("MEDIUM")
  notifyChannels             String?
  cooldownMinutes            Int                @default(5)
  enabled                    Boolean            @default(true)
  escalationEnabled          Boolean            @default(false)
  escalationLevels           String?
  autoEscalate               Boolean            @default(false)
  escalationIntervalMinutes  Int                @default(30)
  maxSeverity                String             @default("CRITICAL")
  deduplicationWindowMinutes Int                @default(10)
  createdAt                  DateTime           @default(now())
  updatedAt DateTime @updatedAt
  AlertSuppression           AlertSuppression[]
  NetworkAlert               NetworkAlert[]

  @@index([enabled])
}

model AlertSuppression {
  id           String     @id @default(uuid())
  alertRuleId  String?
  reason       String     @default("")
  suppressedBy String     @default("")
  startsAt     DateTime   @default(now())
  endsAt       DateTime?
  createdAt    DateTime   @default(now())
  updatedAt DateTime @updatedAt
  AlertRule    AlertRule? @relation(fields: [alertRuleId], references: [id])

  @@index([alertRuleId])
  @@index([endsAt])
  @@index([startsAt])
}

model Announcement {
  id          String    @id @default(uuid())
  title       String
  message     String
  type        String    @default("INFO")
  priority    Int       @default(0)
  target      String    @default("ALL")
  channels    String    @default("IN_APP")
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([isActive])
  @@index([priority])
  @@index([target])
  @@index([type])
}

model AnnouncementDismissal {
  id             String   @id @default(uuid())
  announcementId String
  userId         String
  createdAt      DateTime @default(now())

  @@unique([announcementId, userId])
  @@index([announcementId])
  @@index([userId])
}

model ApiKey {
  id                String    @id @default(uuid())
  name              String
  key               String    @unique
  userId            String?
  scopes            String?
  lastUsedAt        DateTime?
  lastUsedUserAgent String    @default("")
  requestCount      Int       @default(0)
  requestsPerMinute Int       @default(60)
  requestsPerDay    Int       @default(1000)
  autoExpiryDays    Int       @default(0)
  expiresAt         DateTime?
  lastRotatedAt     DateTime?
  ipWhitelist       String    @default("")
  status            String    @default("active")
  createdAt         DateTime  @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
  @@index([status])
}

model Area {
  id                       String                     @id @default(uuid())
  name                     String
  code                     String                     @unique
  description              String                     @default("")
  parentId                 String?
  assignedTechnicianId     String?
  assignedAgentId          String?
  latitude                 Float?
  longitude                Float?
  status                   AreaStatus                 @default(ACTIVE)
  sortOrder                Int                        @default(0)
  polygonBoundary          String?
  createdAt                DateTime                   @default(now())
  updatedAt DateTime @updatedAt
  CollectionAgent          CollectionAgent?           @relation(fields: [assignedAgentId], references: [id])
  Technician               Technician?                @relation(fields: [assignedTechnicianId], references: [id])
  Area                     Area?                      @relation("AreaToArea", fields: [parentId], references: [id])
  other_Area               Area[]                     @relation("AreaToArea")
  AreaBudgetLimit          AreaBudgetLimit[]
  CaptivePortal            CaptivePortal[]
  Complaint                Complaint[]
  Installation             Installation[]
  NetworkDevice            NetworkDevice[]
  RecurringInvoiceTemplate RecurringInvoiceTemplate[]
  Subnet                   Subnet[]
  Subscriber               Subscriber[]
  ProvisioningTemplate     ProvisioningTemplate[]

  @@index([assignedAgentId])
  @@index([assignedTechnicianId])
  @@index([parentId])
  @@index([status])
}

model AreaBudgetLimit {
  id             String           @id @default(uuid())
  areaId         String
  cycleType      BillingCycleType @default(MONTHLY)
  allottedAmount Float            @default(0)
  usedAmount     Float            @default(0)
  cycleStartDate DateTime
  cycleEndDate   DateTime?
  alertThreshold Float            @default(80)
  status         String           @default("active")
  createdAt      DateTime         @default(now())
  updatedAt DateTime @updatedAt
  Area           Area             @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@index([areaId])
  @@index([cycleStartDate])
}

model AttendanceRecord {
  id           String     @id @default(uuid())
  technicianId String
  date         DateTime
  checkIn      DateTime?
  checkOut     DateTime?
  status       String     @default("PRESENT")
  notes        String     @default("")
  createdAt    DateTime   @default(now())
  Technician   Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@unique([technicianId, date])
  @@index([date])
  @@index([technicianId])
}

model AuditLog {
  id             String    @id @default(uuid())
  userId         String?
  userName       String    @default("System")
  action         String
  entity         String
  entityId       String
  details        String?
  previousValues String?
  endpoint       String    @default("")
  method         String    @default("")
  ipAddress      String    @default("")
  userAgent      String    @default("")
  timestamp      DateTime  @default(now())
  isArchived     Boolean   @default(false)
  archivedAt     DateTime?
  User           User?     @relation(fields: [userId], references: [id])

  @@index([action, entity, timestamp])
  @@index([endpoint])
  @@index([entityId])
  @@index([entity])
  @@index([entity, timestamp])
  @@index([timestamp])
  @@index([userId])
  @@index([userName])
}

// ============================================================
// PHASE 1 — DB-backed RBAC + Feature Flags + Licensing + Module State
// Added per docs/architecture/12_IMPLEMENTATION_PHASE_ROADMAP.md Phase 1
// These complement v1's existing enum-based UserRole + hardcoded ROLE_PERMISSIONS
// (which remain as the default roles; the DB-backed models allow custom role
//  management + per-tenant feature flags + license enforcement).
// ============================================================

model Role {
  id           String   @id @default(uuid())
  name         String   @unique
  slug         String   @unique
  description  String   @default("")
  isSystem     Boolean  @default(false)  // System roles can't be deleted
  isBreakGlass Boolean  @default(false)  // Break-glass role (emergency access)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  userAssignments UserRoleAssignment[]
  permissions  RolePermission[]

  @@index([slug])
  @@index([sortOrder])
}

model Permission {
  id          String   @id @default(uuid())
  resource    String   // e.g., "subscribers", "plans", "users"
  action      String   // e.g., "read", "create", "update", "delete"
  description String   @default("")
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  roles       RolePermission[]

  @@unique([resource, action])
  @@index([resource])
  @@index([action])
}

model RolePermission {
  roleId       String
  permissionId String
  assignedAt   DateTime  @default(now())
  assignedBy   String?
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserRoleAssignment {
  id         String    @id @default(uuid())
  userId     String
  roleId     String
  assignedAt DateTime  @default(now())
  assignedBy String?
  expiresAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([roleId])
  @@index([expiresAt])
}

model FeatureFlag {
  id          String   @id @default(uuid())
  key         String   @unique  // e.g., "ai_advisor_enabled"
  name        String
  description String   @default("")
  enabled     Boolean  @default(false)
  value       String?  // optional value (e.g., "max_users=1000")
  scope       String   @default("global")  // global | user | tenant
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([enabled])
  @@index([scope])
}

model License {
  id           String    @id @default(uuid())
  key          String    @unique
  productName  String
  customerName String
  maxUsers     Int       @default(0)
  maxSessions  Int       @default(0)
  features     Json?
  status       String    @default("ACTIVE")  // ACTIVE | EXPIRED | SUSPENDED | REVOKED
  issuedAt     DateTime  @default(now())
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([expiresAt])
}

model ModuleState {
  id             String   @id @default(uuid())
  moduleId       String   @unique  // matches Module.id in src/lib/modules/registry.ts
  enabled        Boolean  @default(true)
  deploymentType String   @default("isp")  // matches DEPLOYMENT_PRESETS
  settings       Json?
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  @@index([enabled])
  @@index([deploymentType])
}

model BackupRecord {
  id               String    @id @default(uuid())
  type             String    @default("full")
  status           String    @default("IN_PROGRESS")
  fileSize         Float     @default(0)
  filePath         String    @default("Local")
  duration         Int       @default(0)
  triggeredBy      String    @default("manual")
  encrypted        Boolean   @default(false)
  changeCount      Int       @default(0)
  verified         Boolean   @default(false)
  verifiedAt       DateTime?
  conflictDetected Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([status])
}

model BandwidthLog {
  id            String        @id @default(uuid())
  deviceId      String
  interfaceName String        @default("")
  downloadBps   Int           @default(0)
  uploadBps     Int           @default(0)
  totalBps      Int           @default(0)
  timestamp     DateTime      @default(now())
  NetworkDevice NetworkDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([deviceId, timestamp])
  @@index([timestamp])
}

model BandwidthPolicy {
  id                  String   @id @default(uuid())
  name                String
  description         String   @default("")
  planId              String?
  radiusGroupId       String?
  downloadKbps        Int
  uploadKbps          Int
  burstDownloadKbps   Int      @default(0)
  burstUploadKbps     Int      @default(0)
  burstDurationSec    Int      @default(0)
  priority            Int      @default(5)
  ceilingDownloadKbps Int      @default(0)
  ceilingUploadKbps   Int      @default(0)
  tcClassId           String   @default("")
  tcParentId          String   @default("")
  interfaceId         String?
  fapDownloadKbps     Int?
  fapUploadKbps       Int?
  fapDataLimitMb      Int?
  hardDataLimitMb     Int?
  // POL-ENGINE-1: bandwidth policy attributes
  policyFor           BwPolicyFor   @default(USER)
  policyType          BwPolicyType  @default(STRICT)
  totalKbps           Int?
  shared              Boolean       @default(false)
  enabled             Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt DateTime @updatedAt
  FairAccessPolicy    FairAccessPolicy[]
  Plan                Plan[]

  @@index([enabled])
  @@index([interfaceId])
  @@index([planId])
  @@index([radiusGroupId])
}

model BandwidthThrottleConfig {
  id                String        @id @default(uuid())
  deviceId          String
  maxDownloadMbps   Int           @default(100)
  maxUploadMbps     Int           @default(50)
  scheduleEnabled   Boolean       @default(false)
  scheduleStartTime String        @default("09:00")
  scheduleEndTime   String        @default("18:00")
  scheduleDays      String?
  enabled           Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt DateTime @updatedAt
  NetworkDevice     NetworkDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([enabled])
}

model BatchProvisioningJob {
  id                   String               @id @default(uuid())
  templateId           String
  filename             String               @default("")
  totalUsers           Int                  @default(0)
  completedUsers       Int                  @default(0)
  failedUsers          Int                  @default(0)
  status               BatchJobStatus       @default(PENDING)
  startedBy            String?
  startedAt            DateTime?
  completedAt          DateTime?
  errorDetail          String               @default("")
  createdAt            DateTime             @default(now())
  updatedAt DateTime @updatedAt
  template             ProvisioningTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  StartedBy            User?                 @relation(fields: [startedBy], references: [id])

  @@index([createdAt])
  @@index([status])
  @@index([templateId])
}

model BillingMilestone {
  id              String   @id @default(uuid())
  planId          String
  name            String
  thresholdDataMb Int      @default(0)
  speedDownKbps   Int      @default(0)
  speedUpKbps     Int      @default(0)
  priority        Int      @default(0)
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt DateTime @updatedAt
  Plan            Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@index([priority])
}

model BotCommand {
  id          String   @id @default(uuid())
  trigger     String
  response    String
  description String   @default("")
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([trigger])
}

model BwSample {
  id             String         @id @default(uuid())
  sourceType     BwSampleSource
  sourceId       String         @default("")
  sourceName     String         @default("")
  downloadBps    Int            @default(0)
  uploadBps      Int            @default(0)
  totalBps       Int            @default(0)
  downloadBytes  BigInt         @default(0)
  uploadBytes    BigInt         @default(0)
  totalBytes     BigInt         @default(0)
  activeSessions Int            @default(0)
  timestamp      DateTime       @default(now())

  @@index([sourceType, sourceId])
  @@index([timestamp])
}

model CaptivePortal {
  id                                                            String               @id @default(uuid())
  name                                                          String
  description                                                   String               @default("")
  template                                                      PortalTemplate?
  loginMethod                                                   PortalLoginMethod    @default(RADIUS)
  theme                                                         String?
  welcomeTitle                                                  String               @default("Welcome")
  welcomeMessage                                                String               @default("")
  tosText                                                       String               @default("")
  successMessage                                                String               @default("You are now connected!")
  timeoutMessage                                                String               @default("Your session has expired. Please login again.")
  dataCapMessage                                                String               @default("You have reached your data limit.")
  sessionTimeoutSec                                             Int                  @default(86400)
  idleTimeoutSec                                                Int                  @default(3600)
  dataLimitMb                                                   Int?
  fapDataLimitMb                                                Int?
  bandwidthLimitDown                                            Int                  @default(0)
  bandwidthLimitUp                                              Int                  @default(0)
  redirectUrl                                                   String               @default("")
  originalUrlParam                                              String               @default("original_url")
  allowedHosts                                                  String?
  enableCaptiveDetection                                        Boolean              @default(true)
  macAuthEnabled                                                Boolean              @default(false)
  macAuthUnknownAction                                          String               @default("DENY")
  socialProviders                                               String?
  voucherRequired                                               Boolean              @default(false)
  voucherReusePolicy                                            String               @default("SINGLE_USE")
  interfaceId                                                   String?
  locationId                                                    String?
  siteName                                                      String               @default("")
  venueType                                                     String               @default("")
  maxConcurrentSessions                                         Int                  @default(0)
  passthroughMode                                               Boolean              @default(false)
  customLoginPageUrl                                            String               @default("")
  postLoginAdUrl                                                String               @default("")
  collectPhone                                                  Boolean              @default(false)
  collectEmail                                                  Boolean              @default(false)
  collectName                                                   Boolean              @default(false)
  partnerId                                                     String?
  revenueSharePercent                                           Float                @default(0)
  priority                                                      Int                  @default(0)
  scheduleConfig                                                String?
  enabled                                                       Boolean              @default(false)
  // ── StaySuite captive portal engine fields (added for portal-page.tsx) ──
  listenIp                                                      String               @default("0.0.0.0")
  listenPort                                                    Int                  @default(80)
  useSsl                                                        Boolean              @default(false)
  sslCertPath                                                   String?
  sslKeyPath                                                    String?
  isDefault                                                     Boolean              @default(false)
  autoAuthEnabled                                               Boolean              @default(true)
  maxConcurrent                                                 Int                  @default(1000)
  sessionTimeout                                                Int                  @default(86400)
  idleTimeout                                                   Int                  @default(3600)
  failMessage                                                   String?
  slug                                                          String               @unique @default("default-zone")
  roamingMode                                                   String               @default("auth_origin")
  allowsRoamingFrom                                             String               @default("[]")
  authMethod                                                    String               @default("voucher")
  maxBandwidthDown                                              Int                  @default(5242880)
  maxBandwidthUp                                                Int                  @default(1048576)
  bandwidthPolicy                                               String               @default("zone")
  nasIdentifier                                                 String               @default("")
  ssidList                                                      String               @default("[]")
  captchaEnabled                                                Boolean              @default(false)
  captchaSiteKey                                                String?
  captchaSecretKey                                              String?
  createdAt                                                     DateTime             @default(now())
  updatedAt DateTime @updatedAt
  SystemInterface                                               SystemInterface?     @relation(fields: [interfaceId], references: [id])
  location                                                      Area?                @relation(fields: [locationId], references: [id])
  partner                                                       CollectionAgent?     @relation(fields: [partnerId], references: [id])
  DhcpSubnet                                                    DhcpSubnet[]
  DnsRecord                                                     DnsRecord[]
  PortalAccessRule                                              PortalAccessRule[]
  PortalAdZone                                                  PortalAdZone[]
  PortalEventLog                                                PortalEventLog[]
  PortalMacWhitelist                                            PortalMacWhitelist[]
  PortalSchedule_PortalSchedule_overridePortalIdToCaptivePortal PortalSchedule[]     @relation("PortalSchedule_overridePortalIdToCaptivePortal")
  PortalSchedule_PortalSchedule_portalIdToCaptivePortal         PortalSchedule[]     @relation("PortalSchedule_portalIdToCaptivePortal")
  PortalSession                                                 PortalSession[]
  PortalVoucherPool                                             PortalVoucherPool[]
  Subnet                                                        Subnet[]
  PartnerPortalMapping                                           PartnerPortalMapping[]
  // ── StaySuite portal engine relations ──
  authMethods                 PortalAuthentication[]
  portalMappings              PortalMapping[]
  portalMappingsFallback      PortalMapping[] @relation("PortalMappingFallback")
  portalPages                 PortalPage[]
  PortalABTest                PortalABTest[]
  PortalDnsRecord             PortalDnsRecord[]

  @@index([enabled])
  @@index([interfaceId])
  @@index([loginMethod])
}

model CgnatMapping {
  id             String     @id @default(uuid())
  cgnatPoolId    String?
  mappingType    String     @default("SNAT")
  internalIp     String
  internalPort   Int        @default(0)
  externalIp     String
  externalPort   Int        @default(0)
  portBlockCount Int        @default(0)
  subscriberId   String?
  subnetId       String?
  protocol       String     @default("ALL")
  sessionId      String     @default("")
  isActive       Boolean    @default(true)
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  createdAt      DateTime   @default(now())
  updatedAt DateTime @updatedAt
  CgnatPool      CgnatPool? @relation(fields: [cgnatPoolId], references: [id])

  @@index([cgnatPoolId])
  @@index([externalIp])
  @@index([internalIp])
  @@index([isActive])
  @@index([subscriberId])
}

model CgnatPool {
  id             String         @id @default(uuid())
  name           String
  description    String         @default("")
  poolType       String         @default("SNAT_POOL")
  startIp        String
  endIp          String
  portBlockSize  Int            @default(512)
  portRangeStart Int            @default(1024)
  portRangeEnd   Int            @default(65535)
  activeMappings Int            @default(0)
  maxMappings    Int            @default(0)
  healthCheckIp  String         @default("")
  enabled        Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt DateTime @updatedAt
  CgnatMapping   CgnatMapping[]
  Subnet         Subnet[]

  @@index([enabled])
}

model ChurnCommunication {
  id           String   @id @default(uuid())
  trackingId   String
  subscriberId String
  actionType   String   @default("")
  actionDetail String   @default("")
  note         String   @default("")
  createdBy    String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([subscriberId])
  @@index([trackingId])
}

model ChurnTracking {
  id           String   @id @default(uuid())
  subscriberId String
  status       String   @default("TRACKING")
  notes        String   @default("")
  assignedToId String?
  createdAt    DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([subscriberId])
}

model CoaEvent {
  id              String     @id @default(uuid())
  subscriberId    String
  radiusSessionId String?
  coaType         CoaType
  coaStatus       CoaStatus  @default(REQUESTED)
  oldPlanId       String?
  newPlanId       String?
  oldBwPolicyId   String?
  newBwPolicyId   String?
  bwPercent       Float      @default(0)
  triggeredBy     String     @default("")
  triggeredAt     DateTime   @default(now())
  completedAt     DateTime?
  errorDetail     String     @default("")
  Subscriber      Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@index([coaStatus])
  @@index([coaType])
  @@index([subscriberId])
  @@index([triggeredAt])
}

model CollectionAgent {
  id                  String          @id @default(uuid())
  userId              String          @unique
  name                String
  phone               String          @default("")
  assignedAreaIds     String?
  dailyTarget         Float           @default(0)
  monthlyTarget       Float           @default(0)
  totalCollectedToday Float           @default(0)
  totalCollectedMonth Float           @default(0)
  commissionRate      Float           @default(0)
  totalCommission     Float           @default(0)
  createdAt           DateTime        @default(now())
  updatedAt DateTime @updatedAt
  Area                Area[]
  CaptivePortal       CaptivePortal[]
  User                User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CommissionPayout {
  id         String    @id @default(uuid())
  agentId    String
  amount     Float     @default(0)
  period     String    @default("")
  status     String    @default("PENDING")
  paidOn     DateTime?
  approvedBy String?
  createdAt  DateTime  @default(now())

  @@index([agentId])
  @@index([period])
  @@index([status])
}

model Competitor {
  id                 String   @id @default(uuid())
  name               String
  planName           String
  speed              String   @default("")
  dataLimit          String   @default("")
  price              Float
  validity           String   @default("")
  category           String   @default("")
  notes              String   @default("")
  marketSharePercent Float    @default(0)
  createdAt          DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model CompetitorPriceHistory {
  id           String   @id @default(uuid())
