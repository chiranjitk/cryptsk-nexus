// ============================================================
// CAPTIVE PORTAL ENGINE (StaySuite captive portal — adapted)
// property → partner, tenant removed, DNS models prefixed Portal*
// ============================================================

/// PortalAuthentication — Auth methods per portal instance
model PortalAuthentication {
  id            String        @id @default(uuid())
  partnerId     String?
  portalId      String
  method        String        @default("voucher") // voucher, room_number, pms_credentials, sms_otp, social, mac_auth, open
  enabled       Boolean       @default(true)
  priority      Int           @default(0)
  config        String        @default("{}") // JSON: method-specific settings
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  CaptivePortal CaptivePortal @relation(fields: [portalId], references: [id], onDelete: Cascade)

  @@unique([portalId, method])
  @@index([partnerId])
  @@index([portalId])
}

/// PortalMapping — Maps portal instance to subnet/VLAN/SSID
model PortalMapping {
  id               String        @id @default(uuid())
  partnerId        String?
  portalId         String
  ipPoolId         String?       // FK to PartnerIpPool — the IP pool/subnet assigned to this portal
  vlanId           Int?
  vlanConfigId     String?
  ssid             String?
  subnet           String?
  priority         Int           @default(0)
  fallbackPortalId String?
  enabled          Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  CaptivePortal    CaptivePortal @relation(fields: [portalId], references: [id], onDelete: Cascade)
  FallbackPortal   CaptivePortal? @relation("PortalMappingFallback", fields: [fallbackPortalId], references: [id], onDelete: SetNull)
  PartnerIpPool    PartnerIpPool? @relation(fields: [ipPoolId], references: [id], onDelete: SetNull)

  @@index([partnerId])
  @@index([portalId])
  @@index([ipPoolId])
  @@index([ssid])
  @@index([enabled])
}

/// PortalPage — Portal page design/styling per portal instance
model PortalPage {
  id              String                @id @default(uuid())
  portalId        String
  language        String                @default("en")
  title           String?
  subtitle        String?
  logoUrl         String?
  backgroundImage String?
  backgroundColor String                @default("#ffffff")
  textColor       String                @default("#1f2937")
  accentColor     String                @default("#0d9488")
  termsText       String?
  termsUrl        String?
  customCss       String                @default("")
  customHtml      String                @default("")
  showSocial      Boolean               @default(false)
  showBranding    Boolean               @default(true)
  // Portal Login Page field visibility — synced from credential policy
  formFields      String                @default("{\"username\":true,\"password\":true,\"roomNumber\":false,\"phone\":false,\"voucherCode\":false,\"terms\":true}")
  authFlow        String                @default("pms_credentials") // pms_credentials | room_number | voucher | sms_otp | open_access
  socialProviders String                @default("{\"google\":false,\"facebook\":false,\"apple\":false}")
  voucherTemplate String                @default("default") // default | elegant | minimal | luxury
  // Advanced design settings (JSON): layout, gradient, typography, form style, content blocks, social links, etc.
  designSettings  String                @default("{}")
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  CaptivePortal   CaptivePortal         @relation(fields: [portalId], references: [id], onDelete: Cascade)
  designHistory   PortalDesignHistory[]

  @@unique([portalId, language])
  @@index([portalId])
}

/// PortalDesignHistory — Design snapshots for versioning/rollback
model PortalDesignHistory {
  id             String      @id @default(cuid())
  portalId       String
  portalPageId   String?
  name           String
  description    String?
  designSettings Json
  createdBy      String?
  createdAt      DateTime    @default(now())
  PortalPage     PortalPage? @relation(fields: [portalPageId], references: [id], onDelete: Cascade)

  @@index([portalId, createdAt(sort: Desc)])
}

/// PortalDesignTemplate — Reusable portal design templates
/// (Renamed from StaySuite's PortalTemplate to avoid conflict with the existing PortalTemplate enum.)
model PortalDesignTemplate {
  id          String   @id @default(uuid())
  name        String
  description String?
  category    String   @default("hotel") // hotel, resort, corporate, minimal, cafe, airport
  thumbnail   String?
  htmlContent String
  cssContent  String
  isBuiltIn   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}

/// PortalWhitelist — Captive portal bypass URLs
model PortalWhitelist {
  id          String   @id @default(uuid())
  partnerId   String?
  domain      String
  path        String? // null = all paths
  description String?
  protocol    String   @default("https") // http, https, both
  bypassAuth  Boolean  @default(true)
  priority    Int      @default(0)
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([domain, path])
  @@index([partnerId])
  @@index([domain])
  @@index([status])
}

/// PortalABTest — A/B testing for portal designs
model PortalABTest {
  id           String    @id @default(cuid())
  portalId     String
  name         String
  designA      Json
  designB      Json
  trafficSplit Int       @default(50)
  status       String    @default("active") // active | paused | stopped
  conversionsA Int       @default(0)
  conversionsB Int       @default(0)
  impressionsA Int       @default(0)
  impressionsB Int       @default(0)
  startDate    DateTime  @default(now())
  endDate      DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  CaptivePortal CaptivePortal @relation(fields: [portalId], references: [id], onDelete: Cascade)

  @@index([portalId])
  @@index([portalId, status])
}

/// PortalAdCampaign — Ad campaigns for captive portal
model PortalAdCampaign {
  id           String    @id @default(uuid())
  partnerId    String?
  name         String
  advertiser   String
  creativeUrl  String
  creativeType String    @default("image") // image, video, html
  linkUrl      String?
  slot         String    @default("banner") // banner, interstitial, footer, sidebar
  priority     Int       @default(0)
  impressions  Int       @default(0)
  clicks       Int       @default(0)
  revenue      Float     @default(0)
  status       String    @default("active") // draft, active, paused, completed
  startDate    DateTime  @default(now())
  endDate      DateTime?
  maxBudget    Float?
  spentBudget  Float     @default(0)
  targeting    String?   @default("{}") // JSON: { guestType, roomType, language, etc. }
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([partnerId])
  @@index([status])
  @@index([startDate, endDate])
}

/// WiFiSession — Guest WiFi session tracking (for portal analytics)
model WiFiSession {
  id           String    @id @default(uuid())
  planId       String?
  username     String?
  acctUniqueId String?
  macAddress   String?
  ipAddress    String?
  deviceName   String?
  deviceType   String?
  startTime    DateTime  @default(now())
  endTime      DateTime?
  dataUsed     BigInt    @default(0)
  duration     Int       @default(0)
  authMethod   String    @default("voucher")
  status       String    @default("active")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([macAddress])
  @@index([username])
  @@index([acctUniqueId])
  @@index([planId])
  @@index([status])
}

/// WiFiVoucher — Voucher codes for WiFi access
model WiFiVoucher {
  id         String    @id @default(uuid())
  planId     String?
  code       String    @unique
  isUsed     Boolean   @default(false)
  usedAt     DateTime?
  validFrom  DateTime  @default(now())
  validUntil DateTime?
  status     String    @default("active")
  notes      String?
  issuedTo   String?
  issuedAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([code])
  @@index([status])
}

/// PortalDnsZone — DNS zone for captive portal (renamed from StaySuite's DnsZone)
model PortalDnsZone {
  id          String      @id @default(uuid())
  partnerId   String?
  domain      String
  description String?
  vlanId      Int?
  enabled     Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  records     PortalDnsRecord[]

  @@unique([domain])
  @@index([partnerId])
}

/// PortalDnsRecord — DNS record for captive portal zone (renamed from StaySuite's DnsRecord)
model PortalDnsRecord {
  id        String   @id @default(uuid())
  zoneId    String
  portalId  String?
  name      String
  type      String   @default("A") // A, AAAA, CNAME, MX, TXT, SRV, PTR
  value     String
  ttl       Int      @default(300)
  priority  Int?
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  PortalDnsZone PortalDnsZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  CaptivePortal CaptivePortal? @relation(fields: [portalId], references: [id], onDelete: SetNull)

  @@unique([zoneId, name, type])
  @@index([zoneId])
  @@index([portalId])
}

/// PortalDnsRedirect — DNS-based captive portal redirect rule (renamed from StaySuite's DnsRedirectRule)
model PortalDnsRedirect {
  id           String   @id @default(uuid())
  partnerId    String?
  name         String
  matchPattern String
  targetIp     String
  targetUrl    String?
  autoDnsmasq  Boolean  @default(true)
  applyTo      String   @default("unauthenticated")
  priority     Int      @default(0)
  enabled      Boolean  @default(true)
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([partnerId])
  @@index([enabled])
  @@index([priority])
}

/// PortalWalledGarden — Walled garden entries (allowed without auth) for captive portal
model PortalWalledGarden {
  id          String   @id @default(uuid())
  partnerId   String?
  domain      String
  path        String?
  protocol    String   @default("https")
  description String?
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([domain, path])
  @@index([partnerId])
  @@index([domain])
  @@index([enabled])
}

// ══════════════════════════════════════════════════════════════════
// POLICY ENGINE (POL-ENGINE-1) — ISP policy types.
// Five policy families bind to Plans; each plan ≤1 policy per family.
// ══════════════════════════════════════════════════════════════════

// POL-ENGINE-2: package billing / control enums
enum BillingScheme {
  PREPAID
  POSTPAID
}

enum IdleTimeoutType {
  NONE
  LIVE_REQUEST
  DATA_TRANSFER
}

enum ExpiryBasis {
  GLOBAL
  FIXED_DATE
  FIXED_DATETIME
}

enum PlanCycleType {
  NONE
  WEEKLY
  MONTHLY
}

enum CycleAmountBasis {
  ACTUAL_DAYS
  FULL_AMOUNT
}

enum QuotaType {
  ABSOLUTE
  RATEBASED
}

enum PolicyCycleType {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

enum AccessStrategy {
  ALLOW
  DISALLOW
}

enum BwPolicyFor {
  POOL
  USER
}

enum BwPolicyType {
  STRICT
  COMMITTED
}

enum DataRatesOn {
  TOTAL
  INDIVIDUAL
}

enum FapType {
  RESET
  NON_RESET
}

enum FapDataOn {
  UPLOAD
  DOWNLOAD
  TOTAL
}

// ── 1. Surfing Quota — time quota with expiry window + cycle reset ──
model SurfingQuotaPolicy {
  id                   String          @id @default(uuid())
  name                 String          @unique
  quotaType            QuotaType       @default(ABSOLUTE)
  allottedMinutes      Int?            // null = unlimited time
  sessionPulseMin      Int             @default(1)
  expiryDays           Int?            // null = unlimited validity
  cycleType            PolicyCycleType @default(NONE)
  cycleAllottedMinutes Int?            // per-cycle time when cycleType != NONE
  description          String          @default("")
  enabled              Boolean         @default(true)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  Plan                 Plan[]

  @@index([enabled])
}

// ── 2. Access Time — weekday slots; outside slots → default strategy ──
model AccessTimePolicy {
  id              String         @id @default(uuid())
  name            String         @unique
  defaultStrategy AccessStrategy @default(ALLOW)
  description     String         @default("")
  enabled         Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  slots           AccessTimeSlot[]
  Plan            Plan[]

  @@index([enabled])
}

model AccessTimeSlot {
  id               String   @id @default(uuid())
  policyId         String
  dayOfWeek        Int      // 0=Sunday .. 6=Saturday
  fromMin          Int      // minutes from midnight
  tillMin          Int      // minutes from midnight
  disallow         Boolean  @default(true) // true = block login in slot; false = pricing factor applies
  pricingFactorPct Float?   // % price factor when disallow=false
  createdAt        DateTime @default(now())
  AccessTimePolicy AccessTimePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId])
}

// ── 3. Data Transfer — volume quota, prepaid cap or postpaid rate ──
model DataTransferPolicy {
  id              String          @id @default(uuid())
  name            String          @unique
  scheme          QuotaType       @default(ABSOLUTE)
  ratesOn         DataRatesOn     @default(TOTAL)
  uploadLimitMb   Int?
  downloadLimitMb Int?
  totalLimitMb    Int?
  cycleType       PolicyCycleType @default(NONE)
  cycleLimitMb    Int?
  expiryDays      Int?
  description     String          @default("")
  enabled         Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  Plan            Plan[]

  @@index([enabled])
}

// ── 4. Fair Access — after data cap, throttle via switch-over BW policy ──
model FairAccessPolicy {
  id                          String          @id @default(uuid())
  name                        String          @unique
  fapType                     FapType         @default(RESET)
  resetType                   PolicyCycleType @default(MONTHLY)
  resetMultiplier             Int             @default(1)
  resetTime                   String          @default("23:59:59")
  dataOn                      FapDataOn       @default(TOTAL)
  limitMb                     Int             @default(0)
  switchOverBandwidthPolicyId String?
  switchOverBandwidthPolicy   BandwidthPolicy? @relation(fields: [switchOverBandwidthPolicyId], references: [id], onDelete: SetNull)
  description                 String          @default("")
  enabled                     Boolean         @default(true)
  createdAt                   DateTime        @default(now())
  updatedAt                   DateTime        @updatedAt
  Plan                        Plan[]

  @@index([enabled])
}
