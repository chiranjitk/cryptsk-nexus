datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Minimal schema for client generation - models are in the main project
// This service uses the shared database
model _PrismaMigrate {
  id        String  @id @default(cuid())
  migration String
  finished  Boolean @default(false)
}
