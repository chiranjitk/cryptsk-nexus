# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ============== Dependencies ==============
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ============== Testing ==============
/coverage

# ============== Next.js ==============
/.next/
/out/

# ============== Production builds ==============
/build
/dist
*.tsbuildinfo

# ============== Misc OS / editor ==============
.DS_Store
Thumbs.db
*.pem
*.swp
*.swo
.vscode/
.idea/

# ============== Debug logs ==============
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# ============================================================
# CRYPTSK NEXUS — project-specific rules
# ============================================================

# --- Environment & secrets (NEVER commit) ---
.env
.env.*
!.env.example
!.env.sample

# --- Sandbox runtime artifacts ---
.zscripts/dev.pid
dev.log

# --- SQLite dev databases (production uses PostgreSQL per ADR-004) ---
db/*.db
db/*.db-journal
db/*.db-wal
db/*.db-shm

# --- Tool/junk artifacts (not source) ---
tool-results/
download/

# --- External repo clones (design pack lives in /docs/architecture/) ---
external-repos/

# --- Prisma generated client (regenerated on install) ---
src/generated/prisma/
prisma/migrations/dev/

# --- Gateway plane build artifacts (Go / VPP / FreeRADIUS) ---
gateway/bin/
gateway/build/
gateway/vendor/
gateway/vpp/run/
gateway/vpp/log/
gateway/runtime/
gateway/state/
gateway/**/*.exe

# --- Encrypted backup blobs (AES-256-GCM, still not for git) ---
*.cryptsk
backups/

# --- Rocky 10 deploy runtime state ---
deploy/runtime/
deploy/state/

# --- Next.js auto-generated type reference (regenerated on dev) ---
next-env.d.ts

# --- Sandbox-only skills folder (not part of product source) ---
skills/

# --- Bun lockfile cache (keep bun.lock, ignore cache) ---
.bun/

